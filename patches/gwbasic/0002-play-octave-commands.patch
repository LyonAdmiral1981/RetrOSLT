PLAY: > and < change octave

IBM BASIC 2.0 added the octave commands > and < to PLAY; Microsoft's 1983
GW-BASIC source does not have them, and programs written for BASICA use
them. They go up or down an octave, no further than 6 or 0.

--- a/GWSTS.ASM	2026-11-13 15:59:31.314029969 -0500
+++ b/GWSTS.ASM	2026-11-13 15:59:31.315465871 -0500
@@ -582,6 +582,10 @@
 	DW	OFFSET PLYLEN
 	DB	"X"		;EXECUTE STRING
 	DW	OFFSET MCLXEQ
+	DB	">"		;UP AN OCTAVE (IBM BASIC 2.0)
+	DW	OFFSET POCTUP
+	DB	"<"		;DOWN AN OCTAVE
+	DW	OFFSET POCTDN
 	DB	00		;END OF TABLE
 
 ; TABLE OF INDEXES INTO NOTTAB FOR EACH NOTE
@@ -648,6 +652,15 @@
 	MOV	BYTE PTR OCTAVE,DL
 PLYRET:	RET	
 
+POCTUP:	CMP	BYTE PTR OCTAVE,LOW 6	;NO HIGHER THAN 6
+	JAE	PLYRET
+	INC	BYTE PTR OCTAVE
+	RET	
+POCTDN:	CMP	BYTE PTR OCTAVE,LOW 0	;NO LOWER THAN 0
+	JE	PLYRET
+	DEC	BYTE PTR OCTAVE
+	RET	
+
 PLYNUM:	JNB	PLGOFC		;ERROR IF NO ARG
 	MOV	AL,DL		;GET NOTE NUMBER INTO [AL]
 	OR	AL,AL		;SEE IF ZERO (PAUSE)
