10 REM SKETCH.BAS - draw with the arrow keys
20 REM RetrOS sample program.
30 SCREEN 1:COLOR 0,0:CLS:KEY OFF
40 X=160:Y=96:C=3:PD=1
50 LOCATE 25,1:PRINT "Arrows draw Space pen C color E erase Q";
60 PSET (X,Y),C
70 K$=INKEY$:IF K$="" THEN 70
80 IF LEN(K$)=1 THEN 200
90 K=ASC(MID$(K$,2))
100 IF K=72 AND Y>0 THEN Y=Y-1
110 IF K=80 AND Y<190 THEN Y=Y+1
120 IF K=75 AND X>0 THEN X=X-1
130 IF K=77 AND X<319 THEN X=X+1
140 IF PD THEN PSET (X,Y),C
150 GOTO 70
200 IF K$=" " THEN PD=1-PD
210 IF K$="c" OR K$="C" THEN C=C MOD 3+1
220 IF K$="e" OR K$="E" THEN LINE (0,0)-(319,191),0,BF
230 IF K$="q" OR K$="Q" THEN SCREEN 0:WIDTH 80:KEY ON:END
240 GOTO 70
