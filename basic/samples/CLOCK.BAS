10 REM CLOCK.BAS - a clock with hands, from TIME$
20 REM RetrOS sample program. Press any key to stop.
30 SCREEN 1:COLOR 0,1:CLS:KEY OFF
40 PI=3.14159:CX=160:CY=96:R=80:A=5/6
50 CIRCLE (CX,CY),R+6,3:CIRCLE (CX,CY),R+8,3
60 FOR H=1 TO 12
70   T=H*PI/6:X=CX+SIN(T)*R:Y=CY-COS(T)*R*A
80   CIRCLE (X,Y),2,2:PAINT (X,Y),2,2
90 NEXT H
100 LOCATE 24,13:PRINT "Press any key";
110 OS=-1:DRAWN=0
120 IF INKEY$<>"" THEN 300
130 T$=TIME$:S=VAL(MID$(T$,7,2)):IF S=OS THEN 120
140 OS=S:M=VAL(MID$(T$,4,2)):H=VAL(LEFT$(T$,2)) MOD 12
150 IF DRAWN THEN LINE (CX,CY)-(HX,HY),0:LINE (CX,CY)-(MX,MY),0:LINE (CX,CY)-(SX,SY),0
160 T=(H+M/60)*PI/6:HX=CX+SIN(T)*R*.5:HY=CY-COS(T)*R*.5*A
170 T=(M+S/60)*PI/30:MX=CX+SIN(T)*R*.8:MY=CY-COS(T)*R*.8*A
180 T=S*PI/30:SX=CX+SIN(T)*R*.9:SY=CY-COS(T)*R*.9*A
190 LINE (CX,CY)-(HX,HY),3:LINE (CX,CY)-(MX,MY),3:LINE (CX,CY)-(SX,SY),1
200 DRAWN=1:LOCATE 1,16:PRINT T$;
210 GOTO 120
300 SCREEN 0:WIDTH 80:KEY ON:END
