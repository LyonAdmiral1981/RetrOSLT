10 REM TUNES.BAS - old tunes, played with PLAY
20 REM RetrOS sample program. Ode to Joy is Beethoven's; the others are traditional.
30 CLS:KEY OFF
40 PRINT "TUNES":PRINT
50 PRINT "  1  Ode to Joy (Beethoven)"
60 PRINT "  2  Twinkle, Twinkle, Little Star"
70 PRINT "  3  Frere Jacques"
80 PRINT "  Q  Quit":PRINT
90 PRINT "Which? ";
100 K$=INKEY$:IF K$="" THEN 100
110 PRINT K$:PRINT
120 IF K$="1" THEN GOSUB 200
130 IF K$="2" THEN GOSUB 300
140 IF K$="3" THEN GOSUB 400
150 IF K$="q" OR K$="Q" THEN KEY ON:END
160 GOTO 30
200 PRINT "Ode to Joy"
210 PLAY "MF T120 O3 L4 EEFG GFED CCDE E.D8D2"
220 PLAY "EEFG GFED CCDE D.C8C2"
230 PLAY "DDEC DE8F8EC DE8F8ED CD<G>E"
240 PLAY "EEFG GFED CCDE D.C8C2"
250 RETURN
300 PRINT "Twinkle, Twinkle, Little Star"
310 PLAY "MF T120 O3 L4 CCGG AAG2 FFEE DDC2"
320 PLAY "GGFF EED2 GGFF EED2"
330 PLAY "CCGG AAG2 FFEE DDC2"
340 RETURN
400 PRINT "Frere Jacques"
410 FOR V=1 TO 2
420 PLAY "MF T150 O3 L4 CDEC CDEC EFG2 EFG2"
430 PLAY "L8 GAGF L4 EC L8 GAGF L4 EC"
440 PLAY "C<G>C2 C<G>C2"
450 NEXT V
460 RETURN
