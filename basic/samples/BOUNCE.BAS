10 REM BOUNCE.BAS - a ball, with GET, PUT and SOUND
20 REM RetrOS sample program. Press any key to stop.
30 SCREEN 1:COLOR 1,0:CLS:KEY OFF
40 DIM B%(40)
50 CIRCLE (6,6),5,3:PAINT (6,6),2,3
60 GET (0,0)-(12,12),B%:PUT (0,0),B%,XOR
70 LINE (0,0)-(319,199),3,B
80 X=40:Y=30:DX=3:DY=2
90 PUT (X,Y),B%,XOR
100 IF INKEY$<>"" THEN 200
110 NX=X+DX:NY=Y+DY:HIT=0
120 IF NX<2 OR NX>305 THEN DX=-DX:NX=X+DX:HIT=1
130 IF NY<2 OR NY>185 THEN DY=-DY:NY=Y+DY:HIT=1
140 PUT (X,Y),B%,XOR:PUT (NX,NY),B%,XOR:X=NX:Y=NY
150 IF HIT THEN SOUND 200+Y*4,1
160 GOTO 100
200 SCREEN 0:WIDTH 80:KEY ON:END
